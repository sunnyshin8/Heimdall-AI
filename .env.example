# ============================================================
# Heimdall AI  Environment Variables
# ============================================================

# CockroachDB Connection String (PostgreSQL-compatible)
# Get this from: cockroachlabs.cloud -> Cluster -> Connect -> Connection String
DATABASE_URL=postgresql://username:password@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# GitHub Webhook Secret
# Set this to the same value as your GitHub webhook secret in repo Settings -> Webhooks
# Leave as-is for local dev (signature check is skipped)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# AWS Credentials for Bedrock (Titan Embeddings + Claude 3.5)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Bedrock Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Python Embeddings Service Port (default: 5001)
PYTHON_SERVICE_PORT=5001
